import json, io, os, re, sys, tempfile, threading, time, struct, wave
import numpy as np
from http.server import HTTPServer, BaseHTTPRequestHandler

# Coqui TTS 0.22 checkpoints embed pickled class instances (XttsConfig).
# PyTorch >= 2.6 defaults torch.load to weights_only=True and rejects them,
# which crashes startup (UnpicklingError). The official HuggingFace
# checkpoint is trusted, so restore the legacy pickle deserialization
# for this process only.
import torch
_orig_load = torch.load
def _load(*args, **kwargs):
    kwargs.setdefault('weights_only', False)
    return _orig_load(*args, **kwargs)
torch.load = _load

# torchaudio 2.11 defaults to the torchcodec backend; its wheel is built
# against CUDA and needs libnvtrc.so.13 (absent on ROCm -> import crash).
# Decode the fixed reference WAV via soundfile instead, so no CUDA lib
# is required. XTTS only ever loads our own ./reference.wav here.
import torchaudio
try:
    import soundfile as sf
    def _ta_load(path):
        data, sr = sf.read(path, dtype='float32', always_2d=True)
        return torch.from_numpy(data).t().contiguous(), sr
    torchaudio.load = _ta_load
except ImportError:
    pass

PORT       = int(os.environ.get('TTS_PORT', '{{ tts_port }}'))
TTS_DEVICE = os.environ.get('TTS_DEVICE', 'cpu')
TTS_MAX_CHARS = int(os.environ.get('TTS_MAX_CHARS', '{{ tts_max_chars }}'))
# GPT decoder sampling knobs. Coqui XTTS community defaults deliver the most
# natural German voice. Stronger anti-drift tuning (temp 0.5, repetition
# penalty 4.0) fixes random wrong-language bursts but sounds robotic - if
# drift returns, raise repetition_penalty to 2.5 first.
TTS_TEMPERATURE = float(os.environ.get('TTS_TEMPERATURE', '0.65'))
TTS_TOP_K = int(os.environ.get('TTS_TOP_K', '50'))
TTS_TOP_P = float(os.environ.get('TTS_TOP_P', '0.85'))
TTS_LENGTH_PENALTY = float(os.environ.get('TTS_LENGTH_PENALTY', '1.0'))
TTS_REPETITION_PENALTY = float(os.environ.get('TTS_REPETITION_PENALTY', '2.0'))
REFERENCE  = "{{ ref_file }}"
SAMPLE_RATE = 24000
# Max chars per XTTS forward pass. XTTS asserts text_tokens < gpt_max_text_tokens
# (402 on xtts_v2). German tokenizes ~1.8 chars/token, so ~650 chars (~365 tokens)
# stays safely under 402 while keeping the chunk count (and per-chunk overhead)
# low. Measured: long-text RTF drops from ~2.15 (500-char chunks) to ~1.65
# (700-char), but 700 chars ~= 393 tokens leaves too little headroom.
TTS_CHUNK_CHARS = int(os.environ.get('TTS_CHUNK_CHARS', '650'))
# Same shared key as llama.cpp (file format LLAMA_API_KEY=...)
API_KEY_FILE = os.environ.get('API_KEY_FILE', '/etc/llama-server/api-key')

def _authorized_self(handler):
    """Require Authorization: Bearer <shared llama.cpp key>."""
    header = handler.headers.get('Authorization', '')
    if not header.startswith('Bearer '):
        return False
    token = header[7:].strip()
    try:
        with open(API_KEY_FILE) as f:
            for line in f:
                line = line.strip()
                if line.startswith('LLAMA_API_KEY=') and line.split('=', 1)[1] == token:
                    return True
    except OSError:
        return False
    return False

# Lazy model handling: load on first request, unload after idle.
# Keeping the model resident spins GPU[1] at ~100% busy with NO request
# (Coqui/ROCm idle busy-wait, measured 2026-09-11), which wastes power,
# heats the card and blocks the idle-suspend GPU guard. So load per use.
# After the idle timeout the process exits cleanly and systemd
# (Restart=always) respawns it with a fresh HIP context, freeing GPU[1]
# completely.
TTS_IDLE_TIMEOUT = float(os.environ.get('TTS_IDLE_TIMEOUT', '600'))

_lock = threading.Lock()
_tts = None
_last_use = 0.0
# XTTS conditions on the fixed reference voice. get_conditioning_latents()
# analyzes reference.wav (WavLM + GPT encoder) - expensive and identical for
# every chunk, so compute it once per model load and reuse it.
_cond = None  # (gpt_cond_latent, speaker_embedding)

def _ensure_tts():
    """Load the XTTS model on first use; caller must hold _lock."""
    global _tts, _last_use, _cond
    if _tts is None:
        print('Loading XTTS-v2...', flush=True)
        from TTS.api import TTS
        tts = TTS("{{ model_ref }}")
        if TTS_DEVICE == 'cuda':
            tts.to('cuda')
        else:
            tts.to('cpu')
        _tts = tts
        # Compute the voice conditioning latents once from the reference clip.
        # Subsequent requests reuse them, skipping WavLM/GPT reference analysis.
        _cond = _tts.synthesizer.tts_model.get_conditioning_latents(audio_path=REFERENCE)
        print(f'XTTS-v2 loaded on {TTS_DEVICE}, conditioning latents ready',
              flush=True)
    _last_use = time.time()
    return _tts

TTS_IDLE_POLL = float(os.environ.get('TTS_IDLE_POLL', '5'))

def _idle_unloader():
    """Exit the process after TTS_IDLE_TIMEOUT s without use.

    A simple model unload (empty_cache) does NOT release the KFD context
    on gfx1100, leaving gpu_busy_percent at 100%. Exiting + systemd
    restart gives a clean HIP context with 0% busy. Poll every
    TTS_IDLE_POLL s (default 5, not 60) so the GPU is freed promptly
    after the timeout.
    """
    while True:
        try:
            time.sleep(TTS_IDLE_POLL)
            with _lock:
                if _tts is not None and time.time() - _last_use > TTS_IDLE_TIMEOUT:
                    print('XTTS-v2 idle, unloading + exiting (frees GPU[1])',
                          flush=True)
                    try:
                        torch.cuda.empty_cache()
                    except Exception:
                        pass
                    os._exit(0)
        except Exception:
            pass

threading.Thread(target=_idle_unloader, daemon=True).start()
print(f'XTTS-v2 ready on port {PORT} device {TTS_DEVICE} (lazy load)',
      flush=True)

class TTSHandler(BaseHTTPRequestHandler):
    def _synth_chunk(self, text, speed):
        """Synthesize one chunk and return 24000 Hz mono int16 PCM bytes.

        Calls Xtts.inference directly with the precomputed conditioning
        latents instead of TTS.tts_to_file: the Coqui high-level path
        re-runs get_conditioning_latents() for every chunk, which is the
        dominant cost for long texts. speed is applied as a latent length
        scale inside the model (matches what tts_to_file did).
        """
        tts = _ensure_tts()
        wav = tts.synthesizer.tts_model.inference(
            text=text,
            language='de',
            gpt_cond_latent=_cond[0],
            speaker_embedding=_cond[1],
            temperature=TTS_TEMPERATURE,
            top_k=TTS_TOP_K,
            top_p=TTS_TOP_P,
            length_penalty=TTS_LENGTH_PENALTY,
            repetition_penalty=TTS_REPETITION_PENALTY,
            speed=speed,
        )['wav']
        # XTTS inference returns float32 samples in [-1, 1] at 24000 Hz.
        pcm = np.clip(wav * 32767.0, -32768, 32767).astype('<i2')
        return pcm.tobytes()

    @staticmethod
    def _chunk_sentences(text, max_len):
        """Split text into chunks on sentence boundaries, each <= max_len.

        XTTS processes at most about 250 input tokens per forward pass and
        silently drops the rest of over-long sentences, so a giant single
        request is not reliable. Keep whole sentences together (<= max_len)
        and cut only on whitespace as a fallback for one huge sentence.
        """
        sentences = re.split(r'(?<=[.!?…])\s+', text)
        chunks, cur = [], ''
        for sent in sentences:
            if len(cur) + len(sent) + 1 <= max_len:
                cur = (cur + ' ' + sent).strip()
                continue
            if cur:
                chunks.append(cur)
            # single sentence longer than the cap: hard-cut word-wise
            while len(sent) > max_len:
                cut = sent.rfind(' ', 0, max_len)
                if cut <= 0:
                    cut = max_len
                chunks.append(sent[:cut])
                sent = sent[cut:].lstrip()
            cur = sent
        if cur:
            chunks.append(cur)
        return chunks

    def _synthesize(self, text, speed):
        # XTTS clones the fixed CC0 reference voice; OpenAI voice names are ignored.
        with _lock:
            chunks = self._chunk_sentences(text, TTS_CHUNK_CHARS)
            pcm_parts = []
            for chunk in chunks:
                data = self._synth_chunk(chunk, speed)
                if data:
                    pcm_parts.append(data)
            if not pcm_parts:
                raise RuntimeError('synthesis produced no audio')
            audio = b''.join(pcm_parts)
            buf = io.BytesIO()
            with wave.open(buf, 'wb') as w:
                w.setnchannels(1)
                w.setsampwidth(2)
                w.setframerate(SAMPLE_RATE)
                w.writeframes(audio)
            return buf.getvalue()

    def do_GET(self):
        if '/health' in self.path:
            self._json(200, {'status': 'ok', 'voices': ['kerstin'],
                             'device': TTS_DEVICE, 'license': 'CPML non-commercial'})
        elif '/v1/models' in self.path:
            if not _authorized_self(self):
                self._json(401, {'error': 'Unauthorized'})
                return
            self._json(200, {'data': [{'id': 'xtts-v2', 'object': 'model'}]})
        else:
            self._json(404, {'error': 'not found'})

    def do_POST(self):
        if not _authorized_self(self):
            self._json(401, {'error': 'Unauthorized'})
            return
        if '/v1/audio/speech' in self.path or self.path == '/':
            self._handle_tts()
        else:
            self._json(404, {'error': 'not found'})

    def _json(self, code, obj):
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.end_headers()
        self.wfile.write(json.dumps(obj).encode())

    def _handle_tts(self):
        try:
            length = int(self.headers.get('Content-Length', 0))
            body = json.loads(self.rfile.read(length))
            text = body.get('input') or body.get('text', '')
            if not text:
                self._json(400, {'error': 'no input text'})
                return
            # Cap input length only as a crude safety net (real splitting happens
            # in _chunk_sentences); value comes from TTS_MAX_CHARS env/ansible var.
            text = text[:TTS_MAX_CHARS]
            speed = float(body.get('speed', 1.0))
            speed = max(0.6, min(1.6, speed))
            data = self._synthesize(text, speed)
            self.send_response(200)
            self.send_header('Content-Type', 'audio/wav')
            self.send_header('Content-Length', str(len(data)))
            self.end_headers()
            self.wfile.write(data)
        except Exception as e:
            import traceback
            traceback.print_exc()
            self._json(500, {'error': str(e)})

if __name__ == '__main__':
    HTTPServer(('0.0.0.0', PORT), TTSHandler).serve_forever()